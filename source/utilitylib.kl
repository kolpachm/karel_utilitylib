-- Sring Handling                             
----------------------------------------------------

ROUTINE int2str --(num_:INTEGER) : STRING
VAR 
  s_     :STRING[16]
BEGIN
  CNV_INT_STR(num_, 0, 0, s_) -- Convert integer to string
  s_ = SUB_STR(s_,2,STR_LEN(s_)) -- Remove leading blank character
  RETURN (s_)
END int2str 
----------------------------------------------------
ROUTINE real2str  --(num_:REAL) : STRING
VAR 
  s_ :STRING[16] 
BEGIN 
  CNV_REAL_STR(num_,0,3,s_)--convert real to srting 
  s_ = SUB_STR(s_,2,STR_LEN(s_)) -- Remove leading blank character
  RETURN(s_)
END real2str 
----------------------------------------------------
ROUTINE real2Str2  --(num_:REAL;precs_:INTEGER) : STRING
VAR 
  dummy_str_ :STRING[16] 
BEGIN
  IF UNINIT(num_) THEN 
    RETURN ('*uninit*')
  ENDIF
  CNV_REAL_STR(num_,0,precs_,dummy_str_)--convert real to srting 
  dummy_str_ = SUB_STR(dummy_str_,2,STR_LEN(dummy_str_)) -- Remove leading blank character
  RETURN(dummy_str_)
END real2str2
----------------------------------------------------
ROUTINE bool2str --(bool2cnv_:BOOLEAN) : STRING
BEGIN
  IF UNINIT(bool2cnv_) THEN
    RETURN ('*uninit*')
  ENDIF
  IF bool2cnv_ THEN
    RETURN ('TRUE')
  ELSE
    RETURN ('FALSE')
  ENDIF
END bool2str
----------------------------------------------------
ROUTINE IntParse--(str:STRING;stat:INTEGER):INTEGER 
VAR
  ret_val_              :INTEGER 
BEGIN 
  CNV_STR_INT(str,ret_val_)
  IF UNINIT(ret_val_)THEN 
    stat = -1 --parse failed
    RETURN(0)
  ENDIF
  stat = 0 
  RETURN(ret_val_)
END IntParse
----------------------------------------------------
ROUTINE RealParse--(str:STRING;stat:INTEGER) :REAL
VAR 
  ret_val_  :REAL
BEGIN 
  stat = 0;
  CNV_STR_REAL(str,ret_val_)
  IF UNINIT(ret_val_) THEN 
    stat = -1
    RETURN(0)
  ENDIF
  RETURN(ret_val_)
END RealParse
----------------------------------------------------
ROUTINE SplitStr --(separator:STRING;in_string:STRING;out_str_ary:ARRAY OF STRING;cmd_size:INTEGER;l_stat:INTEGER) FROM
    VAR
    str_size        :INTEGER
    char_ptr        :INTEGER
    ary_ptr		      :INTEGER
    tmp_entry       :STRING[128]
    char            :STRING[1]

    BEGIN
    --init:
    cmd_size = 0
    str_size = 0
    char_ptr = 0
    ary_ptr  = 0
    char = ''
    tmp_entry = ''
    str_size = STR_LEN(in_string)
    IF UNINIT(l_stat) THEN l_stat = 0; ENDIF
    IF (str_size = 0) THEN
        l_stat = -1
        RETURN
    ENDIF
    
    WHILE ((char_ptr <= str_size) AND (ary_ptr < ARRAY_LEN(out_str_ary))) DO
        WHILE ((char <> separator) AND (char_ptr <= str_size)) DO
            -- build string one by one
            tmp_entry = tmp_entry + char
            char_ptr = char_ptr + 1
            char = SUB_STR(in_string,char_ptr,1)
        ENDWHILE
        --reset char => allow next cycle
        char = ''
        ary_ptr = ary_ptr + 1 
        out_str_ary[ary_ptr] = tmp_entry
        tmp_entry = ''
        cmd_size = cmd_size + 1
    ENDWHILE

END SplitStr
----------------------------------------------------
routine ToUpper --(p_char: integer): string

begin
  if (p_char > 96) and (p_char < 123) then
    p_char = p_char - 32
  endif
  return (chr(p_char))
end ToUpper
----------------------------------------------------
ROUTINE ToLower --(str_: sting): string
VAR
asci_code_      :INTEGER
tmp_str_        :STRING[128]
i_              :INTEGER
BEGIN
  tmp_str_ = ''
  FOR i_ =1 TO STR_LEN(str_) DO
    asci_code_ = ORD(str_,i_)
    IF (asci_code_ > 64) AND (asci_code_ < 91) THEN
      asci_code_ = asci_code_ + 32
      tmp_str_ = tmp_str_ + CHR(asci_code_)
    ELSE
      tmp_str_ = tmp_str_ + CHR(asci_code_)
    ENDIF
  ENDFOR
  RETURN (tmp_str_)
END ToLower
