--  Registers
----------------------------------------------------
ROUTINE GetRealReg --(reg_idx_:INTEGER):REAL
--GET_REG(register_no, real_flag, int_value, real_value, status)
--checking reg_idx_ range
VAR 
  real_flg_     :BOOLEAN
  int_val_      :INTEGER 
  real_val_     :REAL  
  stat_         :INTEGER 
BEGIN 
  GET_REG(reg_idx_,real_flg_,int_val_,real_val_,stat_) 
  chk_stat(stat_,'Err Reading Reg[' + int2str(reg_idx_) + ']',2,FALSE) 
  IF (NOT(real_flg_))THEN 
    real_val_ = int_val_
  ENDIF
  RETURN(real_val_)  
END GetRealReg --(reg_idx_:INTEGER) 
---------------------------------------------------------
ROUTINE GetRealReg2 --(reg_idx_:INTEGER):REAL
--GET_REG(register_no, real_flag, int_value, real_value, status)
--!WARNING - does not check reg_idx_ range
-- returns 0 if reg_idx_ is invalid
VAR 
  real_flg_     :BOOLEAN
  int_val_      :INTEGER 
  real_val_     :REAL  
  stat_         :INTEGER 
BEGIN 

  GET_REG(reg_idx_,real_flg_,int_val_,real_val_,stat_) 
  -- posts varning only
  chk_stat(stat_,'RealReg[' + int2str(reg_idx_) + '] not valid!',0,FALSE) 
  IF (stat_ <> 0) THEN
    int_val_ = 0
    real_flg_ = FALSE
  ENDIF
  IF (NOT(real_flg_))THEN 
    real_val_ = int_val_
  ENDIF
  RETURN(real_val_)
END GetRealReg2 --(reg_idx_:INTEGER) 
---------------------------------------------------------
ROUTINE GetIntReg --(reg_idx_:INTEGER):INTEGER 
--checking reg_idx_ range
-- checking value type
VAR 
  real_flg_      :BOOLEAN
  int_val_       :INTEGER 
  real_val_      :REAL  
  stat_          :INTEGER 
BEGIN 
  GET_REG(reg_idx_,real_flg_,int_val_,real_val_,stat_)
  chk_stat(stat_,'Err reading Reg[' + int2str(reg_idx_) + ']',2,FALSE)
  IF(real_flg_) THEN 
    stat_ = E_BADTYPE
    chk_stat(stat_,'Err reading Reg[' + int2str(reg_idx_) + '] - bad type',2,FALSE)
  ENDIF
  RETURN(int_val_)
END GetIntReg
---------------------------------------------------------
ROUTINE GetIntReg2 --(reg_idx_:INTEGER):INTEGER 
-- no type check returned value is truncated
VAR 
  real_flg_      :BOOLEAN
  int_val_        :INTEGER 
  real_val_       :REAL  
  stat_          :INTEGER 
BEGIN 
  GET_REG(reg_idx_,real_flg_,int_val_,real_val_,stat_)
  chk_stat(stat_,'Err reading IntReg',2,FALSE)
  IF(NOT(real_flg_)) THEN 
      RETURN(int_val_)
  ELSE
      stat_ = E_BADTYPE
      chk_stat(stat_,'Err reading IntReg or R val',0,FALSE)
      RETURN(TRUNC(real_val_))
  ENDIF
END GetIntReg2
