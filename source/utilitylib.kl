ROUTINE GetIntArg--(idx_:INTEGER):INTEGER FROM 
VAR 
ret_val_,
val_type_,
i_,
stat_         :INTEGER
r_     :REAL 
s_      :STRING[1]

BEGIN 
  GET_TPE_PRM(idx_,val_type_,i_,r_,s_,stat_) 
  IF (stat_ = 0) THEN 
    IF (val_type_ = TYP_INT) THEN 
      ret_val_ = i_
    ELSE 
      chk_stat(16060,'Get TPE Int: Bad type',2,FALSE)
    ENDIF
  ELSE 
    chk_stat(stat_,'Err getting TPP Arg: ' + int2str(idx_),2,FALSE)
  ENDIF 
  RETURN(ret_val_)
END GetIntArg
----------------------------------------------------
ROUTINE GetRealArg--(idx_:INTEGER):REAL FROM 
VAR 
ret_val_       :REAL
val_type_,
i_,
stat_          :INTEGER
r_     :REAL 
s_      :STRING[1]

BEGIN 
  GET_TPE_PRM(idx_,val_type_,i_,r_,s_,stat_) 
  IF (stat_ = 0) THEN 
    IF (val_type_ = TYP_REAL) THEN 
      ret_val_ = r_
    ELSE 
      chk_stat(16060,'Get TPE Real: Bad type',2,FALSE)
    ENDIF
  ELSE 
    chk_stat(stat_,'Err getting TPP Arg: ' + int2str(idx_),2,FALSE)
  ENDIF 
  RETURN(ret_val_)
END GetRealArg
----------------------------------------------------
ROUTINE GetStrArg--(idx_:INTEGER):STRING FROM  
VAR 
ret_val_       :STRING[32]
stat_         :INTEGER 
val_type_      :INTEGER   
i_      :INTEGER 
r_     :REAL 
s_      :STRING[32] 

BEGIN 
  GET_TPE_PRM(idx_,val_type_,i_,r_,s_,stat_) 
  IF (stat_ = 0) THEN 
    IF (val_type_ = TYP_STRING) THEN 
      ret_val_ = s_ 
    ELSE 
      chk_stat(16060,'Get TPE Real: Bad type',2,FALSE)
    ENDIF 
  ELSE 
    chk_stat(stat_,'Err getting TPP Arg: ' + int2str(idx_),2,FALSE)
  ENDIF 
  RETURN(ret_val_) 
END GetStrArg

