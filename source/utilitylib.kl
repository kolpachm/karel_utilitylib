ROUTINE Get_Din --(port_:INTEGER):BOOLEAN
VAR
  stat_     :INTEGER
  val_      :INTEGER
BEGIN
  IF (port_ = 0) THEN --port not used/configured
    RETURN(FALSE)
  ENDIF
  GET_PORT_VAL(io_din, port_, val_, stat_)
  chk_stat(stat_,'Error reading DIN port', 2,FALSE)
  RETURN(val_ = 1)
END Get_Din
