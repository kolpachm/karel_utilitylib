ROUTINE GetMaxUFrame --:INTEGER
VAR 
  result_    :INTEGER
BEGIN
  result_ = GetSysI('$SCR.$MAXNUMUFRAM')
  RETURN(result_)
END GetMaxUFrame
----------------------------------------------------
ROUTINE GetUFrame --(uf_num_:INTEGER):POSITION
VAR 
max_frms_        :INTEGER
var_name_         :STRING[32]
s_           :STRING[3]
entry_           :INTEGER
stat_             :INTEGER
pos_             :POSITION

BEGIN
  --check if input frame exceeds max frames defined
  max_frms_ = GetMaxUFrame 
  IF(uf_num_ >= 1) AND (uf_num_ <= max_frms_) THEN 
    s_ = int2str(uf_num_)
    var_name_ = '$MNUFRAME[1,' + s_ + ']'
    GET_VAR(entry_,'*SYSTEM*',var_name_,pos_,stat_)
    chk_stat(stat_,'Err getting var' + var_name_,2,FALSE)
  ELSE 
    chk_stat(16028,'Var out of range: UF Num',2,FALSE)
  ENDIF 
  RETURN(pos_)
END GetUFrame
----------------------------------------------------------
ROUTINE GetUTool --(ut_num_:INTEGER) :POSITION

VAR 
max_frms_       :INTEGER      
ret_val_            :POSITION 
var_name_         :STRING[32]
frm_           :STRING[3]
stat_             :INTEGER
entry_           :INTEGER
pos_             :POSITION
BEGIN 
  --check if input franme exceeds max frames defined
  max_frms_ = GetMaxUTool 
  IF(ut_num_ >= 1) AND (ut_num_ <= max_frms_) THEN 
    frm_ = int2str(ut_num_)
    var_name_ = '$MNUTOOL[1,' + frm_ + ']'
    GET_VAR(entry_,'*SYSTEM*',var_name_,pos_,stat_)
    chk_stat(stat_,'Err getting var' + var_name_,2,FALSE)
  ELSE 
    chk_stat(16028,'Var out of range: UT Num',2,FALSE)
  ENDIF
  RETURN(pos_)
END GetUTool 
