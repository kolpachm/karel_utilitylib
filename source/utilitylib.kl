ROUTINE InitPosNull--(pos_:XYZWPREXT)
VAR 
  tmp_pos_ : POSITION
  stat_    : INTEGER
  entry_   : INTEGER
BEGIN 
  GET_VAR(entry_, '*SYSTEM*', '$MOR_GRP[1].$NILPOS', tmp_pos_, stat_)
  chk_stat(stat_,'Error reading nilpos', 2,FALSE)
  pos_ = tmp_pos_
END InitPosNull
----------------------------------------------------
ROUTINE GetPosCur--(tool_nr_:INTEGER;frame_nr_):XYZWPR 
VAR 
  entry_     :INTEGER
  stat_       :INTEGER
  ret_pos_ :XYZWPR
  tmp_frm_ :POSITION
  karl_frame_ :POSITION
BEGIN 
   --setup karel frames in order to get correct position from TP
  tmp_frm_ = GetUTool(tool_nr_)
  SET_VAR(entry_,'*SYSTEM*','$GROUP[1].$UTOOL',tmp_frm_,stat_)
  chk_stat(stat_,'Err setting karl tool',2,FALSE)
  tmp_frm_ = GetUFrame(frame_nr_)
  SET_VAR(entry_,'*SYSTEM*','$GROUP[1].$UFRAME',tmp_frm_,stat_)
  chk_stat(stat_,'Err setting karl frame',2,FALSE)
  ret_pos_ = CURPOS(0,0)
  RETURN(ret_pos_)
END GetPosCur
----------------------------------------------------
ROUTINE GetPosCur2--(tool_:POSITION;fame_:POSITION):XYZWPREXT
VAR 
  ret_pos_ :XYZWPREXT
BEGIN
  $GROUP[1].$UFRAME = fame_
  $GROUP[1].$UTOOL  = tool_
  ret_pos_ = CURPOS(0,0)
  RETURN(ret_pos_)
END GetPosCur2
