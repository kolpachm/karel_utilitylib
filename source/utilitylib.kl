ROUTINE SetSysI--(varname_: STRING; val_: INTEGER)

VAR 
  entry_       :INTEGER
  stat_        :INTEGER 
BEGIN
  SET_VAR(entry_, '*SYSTEM*', varname_, val_, stat_)
  chk_stat(stat_,'Failed to set: ' + varname_,2,FALSE)
END SetSysI
