-- Interface
----------------------------------------------------
ROUTINE GetOpMode -- :INTEGER
-- operating mode 
--CR_T1         = 1   -- Teach mode
--CR_T2         = 0   -- Teach mode
--CR_AUTO       = 3   -- Auto mode
VAR 
  ret_val_ : INTEGER
BEGIN
  ret_val_ = 0
  IF OPIN[8] THEN -- CE/CR key bit0
    ret_val_ = ret_val_ + 1 
  ENDIF
  IF OPIN[9] THEN -- CE/CR key bit1
    ret_val_ = ret_val_ + 2
  ENDIF 
  RETURN(ret_val_)
END GetOpMode
