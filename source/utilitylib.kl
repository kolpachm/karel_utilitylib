-- This routine sets  FLG port and check operation status
ROUTINE set_flg--(port_: INTEGER; val_: BOOLEAN)
VAR
  stat_     :INTEGER
BEGIN
  IF val_ THEN 
    SET_PORT_VAL(io_flag, port_, 1, stat_)
  ELSE 
    SET_PORT_VAL(io_flag, port_, 0, stat_)
  ENDIF
  chk_stat(stat_,'Error setting FLG port', 2,FALSE)
END set_flg
