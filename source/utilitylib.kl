-- This routine gets BOOLEAN type system variable and check operation status
ROUTINE GetSysB--(varname_: STRING): BOOLEAN
VAR
  result_    :BOOLEAN
  entry_     :INTEGER
  stat_     :INTEGER 
BEGIN
  GET_VAR(entry_, '*SYSTEM*', varname_, result_, stat_)
  chk_stat(stat_,'Failed to read: ' + varname_,2,FALSE)
  RETURN(result_)
END GetSysB
----------------------------------------------------------
-- This routine gets INTEGER type system variable and check operation status
ROUTINE GetSysI--(varname_: STRING): INTEGER
VAR
  result_    :INTEGER
  entry_     :INTEGER
  stat_     :INTEGER 
BEGIN
  GET_VAR(entry_, '*SYSTEM*', varname_, result_, stat_)
  chk_stat(stat_,'Failed to get: ' + varname_,2,FALSE)
  RETURN(result_)
END GetSysI
----------------------------------------------------------
ROUTINE GetSysS--(varname_: STRING): STRING
VAR 
  result_   :STRING[254]
  entry_    :INTEGER
  stat_     :INTEGER
BEGIN 
  GET_VAR(entry_,'*SYSTEM*',varname_,result_,stat_)
  chk_stat(stat_,'Error reading ' + varname_, 2,FALSE)
  RETURN(result_)
END GetSysS
