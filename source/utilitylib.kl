-- ERR Handling                             
----------------------------------------------------
ROUTINE PostErrTxt --(msg_:STRING)
VAR 
  msg_len_ : INTEGER
  tmp_str_ : STRING[40]
BEGIN 
  --max len for TPERR = 40 chars
  WRITE TPERROR(CHR(128),CHR(137))
  msg_len_ = STR_LEN(msg_)
  IF (msg_len_ > 40) THEN
    tmp_str_ = SUB_STR(msg_,1,39)
    tmp_str_ = tmp_str_ + '>' --indicate msg_ is truncated
    WRITE TPERROR(tmp_str_,CR)
  ELSE
    WRITE TPERROR(msg_,CR)
  ENDIF
END PostErrTxt
----------------------------------------------------
ROUTINE chk_stat--(stat_:INTEGER;msg_:STRING;severity_:INTEGER,debug_:BOOLEAN)
BEGIN
  IF stat_ <> 0 THEN
    if uninit(debug_) then debug_ = FALSE; endif
    IF debug_ THEN
      POST_ERR(stat_,'',0,0); PAUSE
      PostErrTxt(msg_)
    ELSE 
      log_msg(msg_)
      POST_ERR(stat_,'',0,severity_) 
    ENDIF
  ENDIF
END chk_stat
----------------------------------------------------
--   File
----------------------------------------------------
ROUTINE OpenFile  --(f_:FILE; fpath_:STRING; method:INTEGER):BOOLEAN

VAR 
ret_val_          :BOOLEAN
stat_            :INTEGER

BEGIN
  
  ret_val_ = TRUE
  
  CLR_IO_STAT(f_)
  
  SELECT (method) OF
    CASE(F_RO)    : OPEN FILE f_('RO',fpath_) 
    CASE(F_RW)    : OPEN FILE f_('RW',fpath_) 
    CASE(F_AP)    : OPEN FILE f_('AP',fpath_) 
  ELSE            : RETURN(FALSE)
  ENDSELECT
  stat_ = IO_STATUS(f_)
  IF (stat_ = 0) THEN 
    RETURN(TRUE) 
  ELSE
    chk_stat(stat_,'Err open' + fpath_,0,FALSE) 
    RETURN(FALSE)
  ENDIF
END OpenFile
---------------------------------------------------
ROUTINE CloseFile --(f_:FILE) :BOOLEAN
VAR
  stat_     :INTEGER
BEGIN
  CLOSE FILE f_
  stat_ = IO_STATUS(f_)
  IF stat_ = 0 THEN
    RETURN (TRUE)
  ELSE 
    chk_stat(stat_,'Err closing file',0,FALSE)
    RETURN (FALSE)
  ENDIF 
END CloseFile
----------------------------------------------------
ROUTINE Getline --(f_:FILE;line_:STRING) : BOOLEAN 
BEGIN 
    READ f_(line_)
    IF IO_STATUS(f_) = 0 THEN
        RETURN(TRUE)
    ELSE
        RETURN(FALSE)
    ENDIF
END Getline
