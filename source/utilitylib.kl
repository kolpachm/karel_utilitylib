  stat_    : INTEGER
BEGIN
  GET_VAR(entry_, '*SYSTEM*', '$MOR_GRP[1].$NILPOS', ret_val_, stat_)
  chk_stat(stat_,'Error reading nilpos', 2,FALSE)
  RETURN(ret_val_)
END GetNullPos
