-- LOG                            
----------------------------------------------------
ROUTINE log_pip--(f_:FILE;fpath_:STRING;msg_:STRING;pip_cfg_:BOOLEAN) 
VAR 
  cmos_flg_   :BOOLEAN
  n_sect_     :INTEGER
  rec_size_   :INTEGER
  form_dict_  :STRING[3]
  frm_ele_    :INTEGER
  stat_       :INTEGER
  log_        :STRING[128]
  bok_        :BOOLEAN
BEGIN 
  IF UNINIT(pip_cfg_) THEN pip_cfg_ = TRUE; ENDIF
  IF UNINIT(fpath_) THEN fpath_ = 'PIP:applog.dt'; ENDIF
  IF pip_cfg_ THEN
    cmos_flg_ = TRUE
    n_sect_ = 16
    rec_size_ = 128
    form_dict_ = 'log'
    frm_ele_ = 1
    pipe_config(fpath_,cmos_flg_, n_sect_, rec_size_,form_dict_,frm_ele_,stat_)
    pip_cfg_ = FALSE
  ENDIF
  set_file_atr(f_,ATR_IA)
  set_file_atr(f_,ATR_UF)
  bok_ = OpenFile(f_,fpath_,F_AP)
  log_ = GetSysTimeStr + ': ' + msg_ + CHR(13) + CHR(10)
  WRITE f_(log_::STR_LEN(log_))
  bok_ = CloseFile(f_)
END log_pip
----------------------------------------------------
-- This routine writes log msg_ to user screen
ROUTINE log_msg--(msg_:STRING)
CONST 
  TM_PLACEH = '         '
VAR
  time_str_  : STRING[9]
  msg_split_ : ARRAY[9] OF STRING[31] --
  -- max char pre USER screen line is 9(time) + 31(text) = 40
  split_div_  : INTEGER
  split_mod_ : INTEGER
  i_         : INTEGER
BEGIN
  split_div_ = STR_LEN(msg_) DIV 31
  split_mod_ = STR_LEN(msg_) MOD 31
  time_str_ = SUB_STR(GetSysTimeStr,11,8)
  time_str_ = time_str_ + ':'
  IF (split_div_ < 1) THEN 
    WRITE TPDISPLAY(CR,time_str_,msg_)
    RETURN 
  ENDIF 
  FOR i_ = 1 TO split_div_ DO
    msg_split_[i_] = SUB_STR(msg_,(i_-1)*31+1,31)
  ENDFOR
  IF (split_mod_ > 0) THEN
    msg_split_[split_div_+1] = SUB_STR(msg_,split_div_*31+1,split_mod_)
  ENDIF 
  FOR i_ = 1 TO split_div_ DO
    IF (i_ = 1) THEN
      WRITE TPDISPLAY(CR,time_str_,msg_split_[i_])
    ELSE
      WRITE TPDISPLAY(CR,TM_PLACEH,msg_split_[i_])
    ENDIF
  ENDFOR
  IF (split_mod_ > 0) THEN
    WRITE TPDISPLAY(CR,TM_PLACEH,msg_split_[split_div_+1])
  ENDIF
END log_msg
